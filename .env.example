# Current standalone site. Apply values to the service environment.
SITE_ORIGIN=https://gloriouscarnivorousplants.top
LEAF_DATA_DIR=/var/lib/leaf-archive
PORT=3100

# Configure these on the server; never commit actual secrets.
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_REDIRECT_URI=https://gloriouscarnivorousplants.top/auth/wechat/callback
# Keep false for standalone deployment; only historical Sites hosting may trust it.
TRUST_SITES_IDENTITY=false

# Optional compatible Photon instance for plant origin lookup; HTTPS only.
MAP_GEOCODER_URL=https://photon.komoot.io/
