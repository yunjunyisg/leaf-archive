# Configure these on the server; never commit actual secrets.
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.example/auth/wechat/callback
# Enable only behind the trusted Sites authentication boundary.
TRUST_SITES_IDENTITY=false
