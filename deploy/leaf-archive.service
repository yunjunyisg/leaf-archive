[Unit]
Description=Leaf Archive
After=network.target
[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/leaf-archive
Environment=NODE_ENV=production
Environment=SITE_ORIGIN=https://gloriouscarnivorousplants.top
Environment=LEAF_DATA_DIR=/var/lib/leaf-archive
Environment=PORT=3100
ExecStart=/usr/local/bin/node /opt/leaf-archive/standalone/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leaf-archive
[Install]
WantedBy=multi-user.target
